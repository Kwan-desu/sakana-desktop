# Sakana Linux Agentic AI — Environment & Secrets
# Copy this file to .env and fill in your credentials. Never commit .env to Git.

# Core Server
SAKANA_HOST=127.0.0.1
SAKANA_PORT=8420
SAKANA_SECRET_KEY=replace-with-random-secret-key
SAKANA_DB_PATH=data/sakana.db

# Default Models & Terminal Protection (yolo | guarded | strict | readonly)
DEFAULT_TERMINAL_MODE=guarded
DEFAULT_MASTER_MODEL=gemini-pro-orchestrator-g1-pro
DEFAULT_SUBAGENT_MODEL=gemini-3.8-flash-high

# CLI Harness Binaries (on Linux PATH or absolute path)
AGY_BIN=agy
CLAUDE_BIN=claude

# Discord Bot Integration
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# Optional Fallback AI Provider Keys (AGY OAuth session is primary)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# GitHub Auto-Update Configuration
GITHUB_REPO_URL=
GITHUB_BRANCH=main
GITHUB_TOKEN=
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_INTERVAL_MINUTES=60

# Incoming Webhook Verification Secret
WEBHOOK_SECRET=replace-with-webhook-secret
